# Copy this file to .env and put your Gemini API key after =
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
PORT=5000
FLASK_DEBUG=0

# Government schemes auto-update (needs GEMINI_API_KEY)
SCHEMES_AUTO_UPDATE=1
SCHEMES_REFRESH_DAYS=7
# Optional: lets you trigger an update manually via POST /api/schemes/refresh (header X-Admin-Token)
ADMIN_TOKEN=
